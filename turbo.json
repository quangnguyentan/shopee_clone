{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ],
            "env": [
                "NODE_ENV",
                "NEXT_PUBLIC_API_URL",
                "NEXT_PUBLIC_SOCKET_URL",
                "NEXT_PUBLIC_RECAPTCHA_SITE_KEY"
            ]
        },
        "lint": {},
        "start:dev": {
            "cache": false,
            "persistent": true
        }
    }
}